# ==========================================
# RDxClaw Environment Configuration Example
# ==========================================
# Copy this file to '.env' and set your keys.
# RDxClaw will automatically load `.env` from the current directory.

# ── Mission Control Security ──────────────
# REQUIRED: Protects your local files, agents, and system from unauthorized network access.
# Make this a secure, random string. You will be prompted for this key 
# when you first open the Mission Control dashboard (http://localhost:8080).
RDXCLAW_SERVER_API_KEY="CHANGE_ME_TO_A_SECURE_PASSWORD"

# ── Primary LLM Provider ──────────────────
# Set your default AI provider and model:
# (Supported providers: openai, anthropic, gemini, groq, vllm, ollama)
RDXCLAW_PROVIDER="openai"
RDXCLAW_MODEL="gpt-4o"

# Uncomment and set the API key for your chosen provider:
# RDXCLAW_OPENAI_API_KEY="sk-..."
# RDXCLAW_ANTHROPIC_API_KEY="sk-ant-..."
# RDXCLAW_GEMINI_API_KEY="AIza..."

# ── Timezone ──────────────────────────────
TZ=Asia/Delhi
